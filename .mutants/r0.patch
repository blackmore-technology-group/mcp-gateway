-
-    /// `tasks/cancel`.
-    pub(crate) async fn cancel(&self, id: RequestId, params: Option<&Value>) -> JsonRpcResponse {
-        let Some(task_id) = task_id_param(params) else {
-            return missing_task_error(id);
-        };
-        let Some(owner) = self.owner.text() else {
-            return missing_task_error(id);
